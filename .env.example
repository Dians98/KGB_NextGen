# Copier en .env.local et remplir. Ne jamais commiter .env.local.

# Formulaire de contact (Resend)
RESEND_API_KEY=
# Adresse qui reçoit les messages. Avec l'expéditeur de test, ce doit être l'adresse exacte du compte Resend.
CONTACT_TO_EMAIL=
# Expéditeur ; onboarding@resend.dev tant qu'aucun domaine n'est vérifié dans Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# URL publique du site (sans / final). Vide en local : http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# "true" uniquement quand l'indexation par les moteurs est validée.
SITE_INDEXABLE=
