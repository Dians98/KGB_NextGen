# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (réglages perso)
.claude/settings.local.json

# impeccable (fichiers locaux)
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/live/server.json
.claude/skills/impeccable/scripts/bin/
**/.impeccable/mocks/
**/.impeccable/questions/
!.env.example

# vidéos HyperFrames : fichiers lourds régénérables (voir videos/README.md)
videos/*/renders/
videos/*/snapshots/
videos/*/capture/
videos/*/.thumbnails/
videos/*/.hyperframes/
videos/*/assets/*.png
videos/*/enregistrement/*.mp4
videos/*/enregistrement/*.jpg
videos/*/enregistrement/*.png
videos/*/assets/fonts/
